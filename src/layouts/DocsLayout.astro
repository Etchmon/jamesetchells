---
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'James Etchells' } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="James Etchells - Software Developer Portfolio" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-background antialiased">
    <div class="flex min-h-screen">
      <Sidebar />
      <main class="flex-1 ml-0 md:ml-64 p-6 md:p-12">
        <div class="max-w-4xl mx-auto">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
